<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="paper">#F6F7F5</color>
    <color name="sign_green">#00643C</color>
    <color name="sign_yellow">#FFCD1C</color>

    <!-- The screen itself is drawn with Compose; this only sets the window behind it. -->
    <style name="Theme.Roundabout" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
