# Copy to .env.local (git-ignored). `node scripts/fetch-web-config.mjs` fills in the first six,
# `node scripts/setup-appcheck.cjs` the last two.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
# reCAPTCHA Enterprise site key used by App Check on the hosted site
VITE_RECAPTCHA_KEY=
# App Check debug token for localhost and automated tests. Never shipped in a build.
APPCHECK_DEBUG_TOKEN=
